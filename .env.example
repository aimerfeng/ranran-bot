# BotFather 发给你的 token
TELEGRAM_BOT_TOKEN=

# 你的 Telegram 数字用户 ID（私聊 bot 后发 /chatid 可见）
TELEGRAM_OWNER_ID=

# DeepSeek 开放平台 API Key（.env 会覆盖系统环境变量里的旧值）
DEEPSEEK_API_KEY=

# 可选，默认 DeepSeek V4.1 Flash（deepseek-v4-flash）；看图用 deepseek-v4-flash-vision-exp
# DEEPSEEK_MODEL=deepseek-v4-flash

# 可选，Codex CLI 超时秒数，默认 180
# CODEX_TIMEOUT_SECONDS=180

# 可选：外部人设文件（追加在系统提示词最后一部分），留空则用项目内 data/persona_extra.txt
# PERSONA_EXTRA_PATH=C:\path\to\persona.txt

# 可选，默认开：在系统提示词最末尾追加"只输出正文"的输出纪律（防止内心戏被当成正文发出去）
# PERSONA_OUTPUT_GUARD=on

# 可选：嵌套 skill 目录，默认项目内 skills/；成人向人设默认关闭，需在群里发 /nsfw on 打开
# SKILLS_DIR_PATH=C:\path\to\skills

# 可选，默认 500：回复超过这个字数就写成 md 文件发出来；0 表示关闭（永远发文本）
# REPLY_FILE_THRESHOLD=500
