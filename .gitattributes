# 统一换行符，避免跨平台 diff 噪音
* text=auto
*.py   text eol=lf
*.md   text eol=lf
*.json text eol=lf
*.yaml text eol=lf
*.yml  text eol=lf
*.txt  text eol=lf
# Windows 脚本保持 CRLF
*.bat  text eol=crlf
*.ps1  text eol=crlf
# 二进制素材
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.gif binary
*.ttf binary
*.otf binary
*.sqlite3 binary
